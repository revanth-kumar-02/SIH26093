# ==============================================================================
# SIH26093 - NHAA 14566 Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH ENVIRONMENT VALUES
# DO NOT COMMIT THE REAL .env FILE WITH SECRETS TO VERSION CONTROL
# ==============================================================================

ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME=SIH26093 NHAA Stress Assessment Backend

# Database Configuration (PostgreSQL with asyncpg driver)
# Format: postgresql+asyncpg://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sih26093
# Local development SQLite async fallback if PostgreSQL is not active:
# DATABASE_URL=sqlite+aiosqlite:///./responder.db

# Authentication & JWT Configuration
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Development Seed Credentials (DO NOT USE REAL USER CREDENTIALS)
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=DevelopmentAdminSecurePass123!
PEOPLE_EMAIL=people@localhost
PEOPLE_PASSWORD=DevelopmentPeopleSecurePass123!

# Application Memory Configuration
MEMORY_MAX_CONTEXT_WORDS=350
MEMORY_MAX_PREVIOUS_SESSIONS=3

# Locked AI Pipeline Configuration
ASR_MODEL_NAME=ai4bharat/indic-conformer-600m-multilingual
ASR_DECODER=ctc
ASR_DEVICE=cpu
USE_MOCK_ASR=false

SPEECH_EMOTION_MODEL=Dpngtm/wav2vec2-emotion-recognition
TEXT_EMOTION_MODEL=SamLowe/roberta-base-go_emotions
EMOTION_DEVICE=cpu
USE_MOCK_EMOTION=false

STRESS_MODEL_NAME=jtvallente/mentalbert_dreaddit_best
STRESS_DEVICE=cpu
USE_MOCK_STRESS=false

GEMMA_MODEL_ID=google/gemma-3n-E2B-it
GEMMA_DEVICE=cpu
USE_MOCK_GEMMA=false
GEMMA_MAX_NEW_TOKENS=1024
GEMMA_TEMPERATURE=0.2

# Optional Hugging Face Token
# HF_TOKEN=your_token_here
