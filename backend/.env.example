# SIH26093 Backend Environment Configuration
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME="SIH26093 NHAA Stress Assessment Backend"

# ASR - IndicConformer-600M-Multi (AI4Bharat)
ASR_MODEL_NAME=ai4bharat/indic-conformer-600m-multilingual
ASR_DECODER=ctc
ASR_DEVICE=cpu
USE_MOCK_ASR=false

# Hugging Face Authentication Token
# Access to ai4bharat/indic-conformer-600m-multilingual is gated.
# 1. Visit: https://huggingface.co/ai4bharat/indic-conformer-600m-multilingual
# 2. Click "Agree and access repository"
# 3. Create a read token at: https://huggingface.co/settings/tokens
# 4. Set token below or export HF_TOKEN in your environment:
HF_TOKEN=

# Emotion Recognition Settings (Internal signals)
SPEECH_EMOTION_MODEL=Dpngtm/wav2vec2-emotion-recognition
TEXT_EMOTION_MODEL=SamLowe/roberta-base-go_emotions
EMOTION_DEVICE=cpu
USE_MOCK_EMOTION=false